# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (OpenNext build output and wrangler state)
/.open-next/
/.wrangler/
.dev.vars*

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# source data (download per README)
/Duke-Source-CSV/


# photo picking working files (regenerate with fetch_plant_photos.py candidates)
/photo_candidates.json
/photo_review.html

# local name candidates (regenerate with fetch_name_candidates.py candidates)
/name_candidates.csv

# African use candidates (regenerate with duke_use_candidates.py candidates)
/use_candidates.csv
